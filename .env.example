# GWICO-SSR Environment Variables
# Copy this file to .env and fill in values as needed.
# These override values in config/default.toml.

# Database
# GWICO_SSR_DB_URL=sqlite:///gwico_ssr.db
# GWICO_SSR_DB_ECHO=false

# NCBI Entrez (required for downloading sequences)
# GWICO_SSR_NCBI_API_KEY=your_ncbi_api_key_here
# GWICO_SSR_NCBI_EMAIL=your_email@example.com

# SSR detection thresholds
# GWICO_SSR_SSR_MIN_REPEATS_MONO=10
# GWICO_SSR_SSR_MIN_REPEATS_DI=5
# GWICO_SSR_SSR_MIN_REPEATS_TRI=3
# GWICO_SSR_SSR_MIN_REPEATS_TETRA=3
# GWICO_SSR_SSR_MIN_REPEATS_PENTA=3
# GWICO_SSR_SSR_MIN_REPEATS_HEXA=2

# Logging
# GWICO_SSR_LOG_LEVEL=INFO
# GWICO_SSR_LOG_FORMAT=json
# GWICO_SSR_LOG_FILE=

# Output
# GWICO_SSR_OUTPUT_DIR=outputs
